APP_SECRET_KEY=replace-with-a-generated-fernet-key
DATABASE_URL=postgresql+psycopg://connection_topology_app:change-me@127.0.0.1:5432/connection_topology
WEB_WORKERS=
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
HOST=127.0.0.1
PORT=8000
HISTORY_RETENTION_DAYS=7
RAW_RETENTION_DAYS=2
IMPORT_TEST_MAX_WORKERS=20
SCAN_MAX_WORKERS=30
SCAN_QUEUE_SIZE=2000
SCAN_JITTER_SECONDS=300
SCAN_LEASE_SECONDS=90
TASK_HEARTBEAT_SECONDS=15
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_TO_CONSOLE=true
